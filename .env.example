# Frontend Environment Variables (Vercel)
VITE_API_URL=https://your-backend-service.onrender.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_ENABLE_LOCAL_GOOGLE_AUTH=false
VITE_APP_NAME=Queen Koba
VITE_APP_VERSION=1.0.0

# Backend Environment Variables (MongoDB & JWT)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/queenkoba?retryWrites=true&w=majority
JWT_SECRET_KEY=your-secure-random-32-character-secret-key
SECRET_KEY=your-flask-session-secret-key

# Safaricom Daraja M-Pesa Configuration
M_PESA_ENV=production
M_PESA_APP_NAME=Queen Koba Skincare
M_PESA_CONSUMER_KEY=your-daraja-consumer-key
M_PESA_CONSUMER_SECRET=your-daraja-consumer-secret
M_PESA_PASSKEY=your-daraja-online-passkey
M_PESA_SHORTCODE=4152819
M_PESA_CALLBACK_URL=https://your-backend-service.onrender.com/payments/mpesa/callback

# CORS & Server Origins
FRONTEND_URL=https://queenkoba.vercel.app
ADMIN_URL=https://queenkoba-admin.vercel.app

