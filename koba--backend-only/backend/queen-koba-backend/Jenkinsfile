pipeline {
    agent any

    environment {
        IMAGE_NAME = 'queenkoba-backend'
        CONTAINER_NAME = 'queenkoba-backend'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build -t queenkoba-backend:latest .
                '''
            }
        }

        stage('Remove Old Container') {
            steps {
                sh '''
                    docker rm -f queenkoba-backend || true
                '''
            }
        }

        stage('Run Backend') {
            steps {
                sh '''
                    docker run -d \
                    --name queenkoba-backend \
                    -p 5001:5000 \
                    queenkoba-backend:latest
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    sleep 5
                    curl -f http://localhost:5001/health
                '''
            }
        }
    }

    post {
        success {
            echo 'Queen Koba Backend deployed successfully!'
        }

        failure {
            echo 'Backend deployment failed!'
            sh 'docker logs queenkoba-backend || true'
        }
    }
}
